{
  "name": "medgame-main",
  "version": "1.0.0",
  "description": "Medgame est un jeu éducatif simulant des scénarios médicaux pour tester tes connaissances du semestre 🏥. Ce n’est pas une source officielle 📚, mais un outil basé sur les références et mis à jour régulièrement.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "node --test test/engine.test.mjs test/mcp.test.mjs test/anticheat.test.mjs",
    "mcp": "node mcp-server.js",
    "validate:cases": "node scripts/validate-cases.mjs",
    "validate:cases:strict": "node scripts/validate-cases.mjs --strict",
    "generate:index": "node scripts/generate-case-index.mjs",
    "generate:feedback": "node scripts/generate-ecos-feedback.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DocteurWu/medgame.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/DocteurWu/medgame/issues"
  },
  "homepage": "https://github.com/DocteurWu/medgame#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.4.1",
    "@supabase/supabase-js": "^2.99.1",
    "dotenv": "^17.3.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "draco3dgltf": "^1.5.7"
  }
