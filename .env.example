# ─────────────────────────────────────────────────────────────────────────────
# MedGame — variables d'environnement
#
# COPIEZ CE FICHIER EN `.env` (`.env` est gitignoré) :
#     cp .env.example .env
#
# Ces variables ne sont lues que par le SERVEUR (proxy Netlify, serveur MCP
# local, scripts de maintenance). Aucun fichier de `js/` ne les lit : le
# navigateur ne doit jamais voir une cle.
#
# Toutes les variables ci-dessous ont une valeur de repli codee en dur dans
# le code. Ce repli permet de lancer le site sans configuration, mais il
# DISABLE une protection : chaque repli est signale ci-dessous.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# URL et cle anonyme du projet. Utilisees par netlify/functions/*.js pour
# compter les quotas LLM (RPC `llm_gate`).
# REPLIS : si absentes, les deux proxies retombent sur un projet et une cle
# ancres en dur, et le comptage de quota part sur ce projet-la.
SUPABASE_URL=https://ton-projet.supabase.co
SUPABASE_ANON_KEY=ta_cle_anon_publique_ici

# Cle de service (controle total). Utilisee pour la RPC `llm_gate`, l'ecriture
# des usages, et la synchronisation du corpus.
# REPLI : si absente, le gate de quota est DESACTIVE (avertissement dans les
# logs du proxy : « gate quota desactive (dev) »).
SUPABASE_SERVICE_ROLE_KEY=ta_cle_service_role_ici

# ── LLM (proxy de traduction de dialogue patient) ────────────────────────────
# Utilisees par netlify/functions/llm-proxy.js et par mcp-server.js.
# REPLI : sans cle, le proxy repond 500 et le mode LLM est indisponible.
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_API_KEY=ta_cle_llm_ici
LLM_MODEL=deepseek-chat

# ── TypeSafe System One (Jev) ───────────────────────────────────────────────
# Proxy de notation ECOS : netlify/functions/jev-proxy.js.
# REPLI : sans cle, le proxy Jev repond 500 (« TYPESAFE_API_KEY non configuree
# cote serveur »). L'URL a une valeur par defaut, seule la cle est requise.
TYPESAFE_API_KEY=ta_cle_typesafe_ici
JEV_API_URL=https://api.typesafe.ai/v1/systemone

# ── Quotas LLM (RGPD) ───────────────────────────────────────────────────────
# QUOTA_SALT est le sel du hash SHA-256 des IP utilisees pour le comptage de
# quota : aucune IP n'est stockee en clair.
# REPLI : 'medgame-quota-default-salt', une CONSTANTE. Le hash reste
# irreversible, mais il devient identique pour toutes les installations : ce
# n'est plus un sel, c'est une constante publique. A definir en production.
QUOTA_SALT=une_chaine_aleatoire_longue_et_unique_par_deploiement

# Adresse affichee quand le quota est epuise.
# REPLI : l'adresse du developpeur codee en dur.
QUOTA_CONTACT_EMAIL=contact@votre-domaine.fr

# ── Hugging Face (optionnel) ────────────────────────────────────────────────
# Serveur UNIQUEMENT, pour router le LLM vers un autre fournisseur.
# REPLI : aucun ; si absent, le proxy utilise LLM_API_URL/LLM_API_KEY.
# HF_API_KEY=hf_xxx_ici

# ── Maintenance (scripts npm) ───────────────────────────────────────────────
# Fichier de retour dperience ECOS appendu par le serveur MCP.
# REPLI : data/feedback.jsonl
# MEDGAME_FEEDBACK_FILE=data/feedback.jsonl

# Variables utilisees uniquement par `npm run sync-supabase` (connexion
# interactive a Supabase). Ne pas les definir pour le simple lancement du jeu.
# SUPABASE_EMAIL=
# SUPABASE_PASSWORD=
# SUPABASE_ADMIN_EMAIL=
# SUPABASE_ADMIN_PASSWORD=
# SUPABASE_SECRET_KEY=
# SUPABASE_KEY=ta_cle_anon_ou_service_ici
